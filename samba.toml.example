# samba.toml — example configuration, with every key shown.
#
# Every key is optional except at least one [[share]]. Unknown keys are
# rejected, so a typo fails at startup instead of silently taking a default.
#
#   samba --check --config samba.toml        validate and report what it enables
#   samba --dump-config --config samba.toml  print the resolved configuration
#   samba --list-dialects --list-ciphers     the negotiation facts
#   samba --list-interfaces --config samba.toml
#
# Keys left commented out are at their default. The share path below is a
# placeholder: point it at a directory that exists.
#
# This file is also what the distribution packages install as
# /etc/samba/samba.toml, so keep it a working configuration.

# Bind address (ip:port). TCP 445 is the only transport: there is no NetBIOS
# port 139, no RPC, no management API and no SMB Direct (RDMA). Binding 445
# needs CAP_NET_BIND_SERVICE or root.
listen = "0.0.0.0:445"

# Worker goroutines, each with its own SO_REUSEPORT listener. 0 = one per CPU
# core. SO_REUSEPORT lets the kernel spread connections across them.
workers = 0

# Advertised server name.
server_name = "SAMBA"

# 0 = warn, 1 = info, 2 = debug. At info and above the startup banner reports
# every capability the server is about to advertise.
log_level = 1

# Allow unauthenticated guest sessions. Defaults to true when no [[user]]
# entries exist, false otherwise — so a config with users denies guest access
# unless you say otherwise here.
# allow_guest = false

# Reject unsigned requests on authenticated sessions. Turning this on means a
# client that cannot sign (a guest, or an old dialect) is refused rather than
# served unsigned.
require_signing = true

# Require SMB3 encryption (AES-128/256-GCM/CCM) for all post-authentication
# traffic. When false, encryption a client asks for (e.g. cifs `seal`) is still
# honored if a cipher is negotiated.
# encrypt = false

# Prefer AES-256 (GCM, then CCM) when the client offers it, instead of honoring
# the client's preference order (which usually picks AES-128-GCM for speed).
# prefer_aes256 = false

# Advertise SMB3 multichannel and accept session binding, so a single client
# mount can stripe I/O across several connections (and CPU cores).
# multichannel = false

# Restrict multichannel interface advertisement to these addresses (e.g. a
# dedicated storage NIC). Empty = every non-loopback interface. Check what
# would be advertised with `samba --list-interfaces --config FILE`.
# advertise_only = ["10.99.0.10"]

# Grant leases: read-caching, plus handle-caching when the client asks for it.
# Write-caching is never granted. Default on.
oplocks = true

# Connection limit. Each connection costs goroutines plus up to one maximum-size
# request frame of buffered data, so this is the main lever on the server's
# worst-case memory use: memory is bounded by roughly
# max_connections x (4.4 MiB + a few tens of KiB). The default (512) suits a
# dedicated file server; raise it for a large deployment and lower it for a small
# container. -1 removes the limit.
# max_connections = 512

# Authentication is NTLMv2 against the [[user]] table below, plus guest sessions
# when `allow_guest` is set. There is no mechanism selector and no Kerberos: it
# was removed deliberately (see AGENTS.md), so `auth` and `[kerberos]` are
# rejected as unknown keys if they are left in an older file.

# At least one share is required. `name` is the SMB share name, `path` must be
# an existing directory, `read_only` (default false) applies to every user:
# authorization is share-level only. "IPC$" is reserved.
[[share]]
name = "data"
path = "/srv/data"

# read_only = true

# A second share, read-only, to show the shape. Share names must be unique.
# [[share]]
# name = "public"
# path = "/srv/public"
# read_only = true

# Optional user database for NTLMv2. Set exactly one of `password` or `nt_hash`
# (32 hex characters). This is the whole account store: there is no directory to
# check against.
# [[user]]
# name = "alice"
# password = "secret"

# [[user]]
# name = "bob"
# nt_hash = "8846f7eaee8fb117ad06bdd830b7586c"
